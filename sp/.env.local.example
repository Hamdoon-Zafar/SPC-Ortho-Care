# Copy this file to .env.local (never commit .env.local) and fill in the values.
# On Cloudflare Pages add the same variables under Settings > Environment variables.

# Sanity project ID. Get it at https://www.sanity.io/manage -> your project -> the ID shown under the project name.
# (Create a project first with `npm create sanity@latest` or on the Sanity website.) Safe to expose publicly.
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Dataset name. "production" is the default created with a new project.
NEXT_PUBLIC_SANITY_DATASET=production

NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# SECRET. Only used by scripts/migrate-to-sanity.mjs on your own computer. Do NOT add it to Cloudflare/GitHub.
# Create at https://www.sanity.io/manage -> your project -> API -> Tokens -> Add API token -> permissions: "Editor".
# Delete the token after the migration has run.
SANITY_API_WRITE_TOKEN=

# Optional: public site address, used for search-engine data once your domain is live (e.g. https://yourdomain.com).
NEXT_PUBLIC_SITE_URL=
